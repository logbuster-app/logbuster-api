APP_ENV=development
LOG_LEVEL=INFO
OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com
DATABASE_URL=
# Chave aleatória e exclusiva por ambiente, com pelo menos 32 bytes.
JWT_SECRET=
JWT_EXPIRES_IN=3600
# IA (SPEC-BACK-09). A equipe usa o plano gratuito do Gemini: crie a chave no
# Google AI Studio e confira lá o nome do modelo e as cotas disponíveis.
# Outros provedores compatíveis com /chat/completions também funcionam
# (OpenAI, Groq, Anthropic): basta trocar URL, chave e modelo.
# Sem URL, chave e modelo, resumo e sugestão de spoiler respondem "unavailable".
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
# flash-lite: rápido e com menos disputa no plano gratuito.
AI_MODEL=gemini-3.5-flash-lite
# "low" deixa o Gemini mais rápido; vazio não envia o parâmetro.
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=15
AI_SPOILER_TIMEOUT_SECONDS=6
# Espera mínima antes de tentar de novo um resumo que falhou.
AI_RETRY_AFTER_SECONDS=60
# Quantidade de avaliações novas que invalida o resumo em cache.
REVIEW_SUMMARY_REGEN_THRESHOLD=3
POSTGRES_USER=logbuster
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=logbuster
# Lista separada por vírgulas.
CORS_ALLOWED_ORIGINS=http://localhost:3000
